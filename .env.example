# Contact form → Google Sheets
#
# Copy this file to .env.local and fill both values in. .env.local is
# gitignored; never commit real values.
#
# Deployed web app URL from the Apps Script editor (ends in /exec).
GOOGLE_SHEETS_WEBHOOK_URL=

# Any long random string. Must match the SECRET constant inside
# google-apps-script/Code.gs.
GOOGLE_SHEETS_SECRET=
